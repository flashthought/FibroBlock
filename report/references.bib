% --- The bistable front-speed result used in fhn.py -------------------------

@book{keener2009,
  author    = {Keener, James and Sneyd, James},
  title     = {Mathematical Physiology I: Cellular Physiology},
  edition   = {2nd},
  publisher = {Springer},
  address   = {New York},
  year      = {2009},
  isbn      = {978-0-387-75846-6},
  note      = {Section 6.2 gives the bistable travelling-front speed
               theta = sqrt(A/2)(V1 - 2 V2 + V3) sqrt(D), which is the formula
               implemented in fibroblock.fhn.analytic_cv_prefactor.}
}

