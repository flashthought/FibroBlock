# ---------------------------------------------------------------------------
# FibroBlock .gitignore
#
# NOTE ON figures/ AND results/:
# These directories are GENERATED by scripts/make_all_figures.py, but they are
# deliberately COMMITTED to the repository so that the written report builds
# without the examiner having to run the pipeline first. They are therefore
# NOT listed here. Only genuinely transient artefacts are ignored.
# ---------------------------------------------------------------------------

# --- Python bytecode and build artefacts -----------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Testing and coverage ---------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Linting / formatting caches -------------------------------------------
.ruff_cache/
.mypy_cache/
.dmypy.json

# --- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Editors / IDEs ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating-system artefacts --------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
.directory
.Trash-*

# --- LaTeX / pandoc intermediates (report build) ---------------------------
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg

# --- Scratch ----------------------------------------------------------------
scratch/
tmp/
*.tmp
